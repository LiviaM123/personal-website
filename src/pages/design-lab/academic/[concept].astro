---
import AcademicStudy from '../../../components/design-lab/AcademicStudy.astro';
import MuseumInteractive from '../../../components/design-lab/MuseumInteractive.astro';

export function getStaticPaths() {
  return ['archive-index', 'natural-history', 'reading-room', 'museum-collection'].map((concept) => ({
    params: { concept },
    props: { concept },
  }));
}

const { concept } = Astro.props;
---
{concept === 'museum-collection' ? <MuseumInteractive /> : <AcademicStudy concept={concept} />}
