---
import '../styles/global.css';
const { title = 'Livia — Personal Archive', description = 'The personal academic and creative archive of Wenxi Miao.', lang = 'en', bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" />
    <title>{title}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{lang === 'zh' ? '跳至主要内容' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
