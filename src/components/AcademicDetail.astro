---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import { languages, pathFor, type Language } from '../data/site';
const { lang, section } = Astro.props as { lang: Language; section: any };
const copy = languages[lang];
const base = import.meta.env.BASE_URL;
const url = (path: string) => `${base}${path.replace(/^\//, '')}`;
const switchHref = pathFor(lang === 'en' ? 'zh' : 'en', `academic/${section.slug}`);
---
<BaseLayout lang={lang} bodyClass="archive-page detail-page" title={`${section.title[lang]} — ${lang === 'en' ? 'Wenxi Miao' : '缪文希'}`} description={section.introduction[lang]}>
  <SiteHeader lang={lang} switchHref={switchHref} />
  <main id="main" class="detail-shell">
    <nav class="breadcrumb" aria-label={lang === 'en' ? 'Breadcrumb' : '面包屑导航'}><a href={url(copy.academic)}>{copy.archive}</a><span>/</span><span>{section.title[lang]}</span></nav>
    <header class="detail-header"><div class="section-meta"><span class="archive-number">{section.number}</span><span>/</span><span>{section.category[lang]}</span></div><h1>{section.title[lang]}</h1><p>{section.introduction[lang]}</p></header>
    <section class="detail-entries" aria-label={lang === 'en' ? 'Entries' : '条目'}>
      {section.entries.map((entry: any) => <article><div class="entry-meta"><span>{entry.category[lang]}</span><span>{copy.dates}</span></div><h2>{entry.title[lang]}</h2><p>{entry.description[lang]}</p></article>)}
      <article class="placeholder-entry"><p>{copy.status}</p></article>
    </section>
    <a class="return-link" href={url(copy.academic)}><span aria-hidden="true">&#8592;</span> {copy.back} {copy.archive}</a>
  </main>
  <img class="botanical-art botanical-detail" src={`${base}art/lily-of-the-valley.webp`} alt="" aria-hidden="true" />
  <footer class="archive-footer"><span>{copy.footer}</span><span>{section.title[lang]}</span></footer>
</BaseLayout>
