---
const { world } = Astro.props as { world: 'academic' | 'elsewhere' };
---

{world === 'academic' ? (
  <svg class="field-art academic-art" viewBox="0 0 720 760" aria-hidden="true">
    <defs>
      <pattern id="archive-grid" width="36" height="36" patternUnits="userSpaceOnUse">
        <path d="M36 0H0V36" fill="none" stroke="currentColor" stroke-width="0.55" />
      </pattern>
    </defs>
    <rect width="720" height="760" fill="url(#archive-grid)" opacity="0.3" />
    <g fill="none" stroke="currentColor">
      <ellipse cx="410" cy="326" rx="251" ry="189" stroke-width="1.1" />
      <ellipse cx="410" cy="326" rx="198" ry="149" stroke-width="0.75" />
      <ellipse cx="410" cy="326" rx="137" ry="103" stroke-width="0.75" />
      <circle cx="410" cy="326" r="42" stroke-width="1.25" />
      <path d="M106 326H684M410 78V574M210 146L610 506M210 506L610 146" stroke-width="0.65" />
      <path d="M119 491C195 424 269 460 333 397S459 274 541 297S638 384 746 320" stroke-width="2" />
      <path d="M91 534C193 449 272 505 352 423S501 314 584 340S655 403 741 365" stroke-width="0.8" />
      <path d="M410 54V86M410 566V598M126 326H158M662 326H694M197 113L219 137M601 515L623 539M197 539L219 515M601 137L623 113" stroke-width="1.4" />
      <path d="M84 646H638M84 656H638" stroke-width="0.7" />
      <path d="M110 638V664M164 644V658M218 638V664M272 644V658M326 638V664M380 644V658M434 638V664M488 644V658M542 638V664M596 644V658" stroke-width="0.8" />
    </g>
    <g fill="currentColor" font-family="Georgia, serif" font-size="10" letter-spacing="2">
      <text x="92" y="94">PLATE I · FIELD MEASURE</text>
      <text x="492" y="617">OBSERVATION / 01</text>
      <text x="392" y="330" font-size="9">A / 01</text>
    </g>
  </svg>
) : (
  <svg class="field-art botanical-field" viewBox="0 0 720 760" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M355 728C371 630 379 536 405 443C431 350 465 270 513 170" stroke-width="2.2" />
      <path d="M404 444C345 415 297 371 265 316M427 378C488 348 532 303 561 247M381 535C323 523 268 495 225 453M455 291C430 235 430 183 449 129" stroke-width="1.35" />
      <path d="M265 316C209 312 162 283 134 236C190 230 241 260 265 316ZM225 453C170 463 119 445 82 404C133 385 192 404 225 453ZM449 129C415 93 407 54 420 16C460 41 470 88 449 129ZM513 170C516 113 549 69 602 49C602 105 572 148 513 170ZM561 247C618 219 669 228 706 265C653 286 598 279 561 247ZM427 378C487 381 532 411 554 463C496 461 451 432 427 378Z" stroke-width="1.25" />
      <path d="M354 620C403 587 453 576 511 590M347 666C296 642 246 641 194 660" stroke-width="1" />
      <path d="M511 590c31-8 55 4 70 31-30 8-54-3-70-31ZM194 660c-29-10-54-4-72 19 28 12 53 5 72-19Z" stroke-width="1" />
      <ellipse cx="556" cy="112" rx="93" ry="49" transform="rotate(-28 556 112)" stroke-width="0.8" />
      <ellipse cx="556" cy="112" rx="80" ry="39" transform="rotate(-28 556 112)" stroke-width="0.55" />
      <path d="M92 102H284M92 111H248M92 120H267" stroke-width="0.6" />
    </g>
    <g fill="currentColor" font-family="Georgia, serif" font-size="10" font-style="italic" letter-spacing="1.5">
      <text x="92" y="82">Herbarium · Specimen II.</text>
      <text x="465" y="700">Private collection</text>
      <text x="518" y="116" font-size="8">LIVIA</text>
    </g>
  </svg>
)}

<style>
  .field-art { width: 100%; height: 100%; color: #76684f; }
  .academic-art { opacity: .34; }
  .botanical-field { opacity: .4; }
</style>
