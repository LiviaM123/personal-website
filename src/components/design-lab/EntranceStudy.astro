---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Field from './Field.astro';
import Emblem from './Emblem.astro';
const { concept } = Astro.props;
const base = import.meta.env.BASE_URL;
const titles = { typography: 'Typography only', fields: 'Atmospheric fields', emblems: 'Emblems' };
const numbers = { typography: '01', fields: '02', emblems: '03' };
---
<BaseLayout signatureOnly={concept === 'fields'} title={`${titles[concept]} — Wency Design Lab`}>
  <nav class="lab-bar" aria-label="Design Lab navigation">
    <a href={`${base}design-lab/`}>Design Lab</a>
    <div>{Object.entries(titles).map(([slug,title])=><a href={`${base}design-lab/${slug}/`} aria-current={slug===concept?'page':undefined}>{numbers[slug]} / {title}</a>)}</div>
    <a href={base}>Current homepage →</a>
  </nav>
  <main id="main" class={`study study-${concept}`}>
    <div class="identity"><p class="eyebrow">A PERSONAL SPACE</p><h1>WENCY<span class="name-dot">.</span></h1><p class="invitation">How would you like to explore?</p></div>
    <div class="study-worlds">
      {[['academic','Academic','Research · Work · Projects · CV'],['elsewhere','Elsewhere','Life · Ideas · Creations']].map(([world,name,subtitle],i)=><a class={`study-world ${world}`} href={`${base}${world}/`}>
        {concept==='fields'&&<div class="field-layer"><Field world={world}/></div>}
        <div class="world-meta"><span>0{i+1}</span><span>{concept==='emblems'?'EX LIBRIS':concept==='fields'?'A FIELD OF EXPLORATION':'A WAY OF LOOKING'}</span></div>
        {concept==='typography'&&<div class="type-interlude"><span class="roman">{i===0?'I':'II'}</span><span class="type-caption">{i===0?'Questions, evidence,\nand the work in between.':'Life, ideas,\nand things made along the way.'}</span></div>}
        {concept==='emblems'&&<div class="emblem-space"><Emblem world={world}/></div>}
        <div class="world-copy"><h2>{name}</h2><p>{subtitle}</p></div>
        <div class="world-bottom"><span>Enter {name}</span><span aria-hidden="true">→</span></div>
      </a>)}
    </div>
    <p class="study-note">Study {numbers[concept]} / {titles[concept]} · Temporary comparison; the current homepage is unchanged.</p>
  </main>
</BaseLayout>
<style>
.lab-bar{width:100%;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);font-size:11px;background:#f0eee8}.lab-bar div{display:flex;gap:25px;flex-wrap:wrap}.lab-bar a{padding:3px 0}.lab-bar a[aria-current=page]{border-bottom:1px solid var(--ink)}.study{width:min(1000px,calc(100% - 80px));margin:auto;padding:60px 0 32px}.identity{margin-bottom:54px}.identity .eyebrow{margin-bottom:22px}.identity h1{font-size:clamp(70px,10vw,108px);letter-spacing:-4px}.study-worlds{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.study-world{position:relative;padding:26px 40px 30px;min-height:340px;display:flex;flex-direction:column;overflow:hidden;color:var(--ink)}.study-world:first-child{border-right:1px solid var(--line)}.world-meta{display:flex;justify-content:space-between;gap:16px;font-size:10px;letter-spacing:1.7px;color:var(--muted);position:relative;z-index:1}.world-meta span:first-child{font-size:12px}.world-copy{position:relative;z-index:1}.world-copy h2{font-size:43px;line-height:1.3;margin-bottom:6px}.world-copy p{font-size:13px;color:var(--muted)}.world-bottom{display:flex;justify-content:space-between;align-items:center;font-size:10px;letter-spacing:1.7px;margin-top:26px;position:relative;z-index:1}.world-bottom span:last-child{font-size:21px}.study-note{font-size:11px;color:var(--muted);text-align:center;margin-top:27px}.type-interlude{display:flex;align-items:center;gap:25px;padding:31px 0 22px;flex:1}.roman{font:italic 88px/.9 Georgia,serif;color:#a8aaa5;letter-spacing:-7px}.elsewhere .roman{color:#b49986}.type-caption{white-space:pre-line;font:italic 16px/1.65 Georgia,serif;color:var(--muted)}.study-typography .world-copy{padding-top:20px;border-top:1px solid var(--line)}.field-layer{position:absolute;inset:0;pointer-events:none;color:var(--ink);opacity:.15}.elsewhere .field-layer{color:#825842;opacity:.22}.field-layer :global(svg){height:100%;width:100%;object-fit:cover}.study-fields .study-world{min-height:400px}.study-fields .world-copy{margin-top:auto;padding:24px 0 6px}.study-fields .world-copy h2{font-size:49px}.study-fields .world-bottom{margin-top:21px}.study-fields .study-world:hover .field-layer{opacity:.22}.study-fields .elsewhere:hover .field-layer{opacity:.3}.field-layer{transition:opacity .25s}.emblem-space{display:flex;align-items:center;justify-content:center;padding:12px 0 18px}.emblem-space :global(svg){width:240px;height:222px;color:var(--ink)}.elsewhere .emblem-space :global(svg){color:#825842}.study-emblems .world-copy{text-align:center}.study-emblems .world-copy h2{font-size:38px}.study-emblems .world-bottom{border-top:1px solid var(--line);padding-top:16px}.study-world:hover .world-bottom{text-decoration:underline;text-underline-offset:5px}@media(max-width:800px){.lab-bar{align-items:flex-start;padding:16px 24px;flex-wrap:wrap}.lab-bar div{order:3;width:100%;gap:18px}.study{width:calc(100% - 48px);padding-top:45px}.study-world{padding:24px}.world-meta{font-size:8px}.type-interlude{gap:15px}.type-caption{font-size:14px}.world-copy h2{font-size:35px}.study-fields .world-copy h2{font-size:38px}}@media(max-width:540px){.study-worlds{grid-template-columns:1fr}.study-world:first-child{border-right:0;border-bottom:1px solid var(--line)}.identity{margin-bottom:36px}.identity h1{font-size:72px}.invitation{font-size:19px}.study-world{min-height:310px}.study-fields .study-world{min-height:340px}.world-meta{font-size:9px}.type-caption{font-size:16px}.emblem-space{padding:8px 0 15px}.emblem-space :global(svg){width:230px;height:212px}.study-note{text-align:left;line-height:1.8}.world-copy h2{font-size:40px}}
</style>
