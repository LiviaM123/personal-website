---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const plate = `${base}design-lab/academic-plate.webp`;
const collections = [
  {
    id: 'healthcare',
    en: 'Healthcare & Strategy',
    zh: '医疗健康与战略',
    enLabel: 'MARKET / INDUSTRY / COMPETITION',
    zhLabel: '市场 / 行业 / 竞争',
    enBody: 'Experience with Roland Berger PTA included healthcare market assessment, industry research and competitive landscape work.',
    zhBody: '在罗兰贝格 PTA 的经历涉及医疗市场评估、行业研究与竞争格局分析。',
  },
  {
    id: 'education',
    en: 'Education & Outreach',
    zh: '教育与科普',
    enLabel: 'TEACHING / EXPERIMENTS / ACCESS',
    zhLabel: '教学 / 实验 / 科普',
    enBody: 'This collection brings together experimental teaching and science outreach at the DNA Learning Center Asia, and biology teaching in Sichuan.',
    zhBody: '这一部分汇集了在冷泉港亚洲 DNA 学习中心的实验教学与科普经历，以及在四川开展生物课程支教的经历。',
  },
  {
    id: 'life-sciences',
    en: 'Life Sciences & Research',
    zh: '生命科学与研究',
    enLabel: 'BIOLOGY / BIOTECH / DATA',
    zhLabel: '生物 / 生物技术 / 数据',
    enBody: 'Biological Sciences study, biotechnology R&D exposure, and analysis of cattle social networks and growth performance form this research field.',
    zhBody: '这一研究领域包括生物科学学习背景、生物科技研发实践，以及牛群社会网络与生长表现的数据分析经历。',
  },
];
---
<BaseLayout signatureOnly title="Museum Collection — Interactive Academic Study" description="An interactive bilingual Academic landing page study for Wency Miao.">
  <nav class="prototype-nav" aria-label="Prototype navigation">
    <a href={`${base}design-lab/academic/`} data-en="Academic studies" data-zh="学术页面方案">Academic studies</a>
    <span data-en="Interactive example" data-zh="交互实例">Interactive example</span>
    <a href={`${base}academic/`} data-en="Current Academic page" data-zh="当前正式 Academic 页面">Current Academic page</a>
  </nav>

  <main id="main" class="museum-example" data-language="en">
    <header class="museum-header">
      <a class="wordmark" href={base}>WENCY MIAO</a>
      <p data-en="ACADEMIC COLLECTION" data-zh="学术档案">ACADEMIC COLLECTION</p>
      <div class="language-switch" role="group" aria-label="Language">
        <button type="button" data-language-choice="en" aria-pressed="true">EN</button>
        <span>/</span>
        <button type="button" data-language-choice="zh" aria-pressed="false">中文</button>
      </div>
    </header>

    <section class="museum-layout">
      <div class="collection-index">
        <div class="index-heading">
          <div>
            <p class="overline" data-en="OPEN COLLECTION" data-zh="开放收藏">OPEN COLLECTION</p>
            <h1 data-en="Fields of practice" data-zh="实践领域">Fields of practice</h1>
          </div>
          <button class="about-button" type="button" data-show-panel="intro" data-en="About Wency" data-zh="关于文希">About Wency</button>
        </div>

        <div class="collection-tabs" role="tablist" aria-label="Academic collection categories">
          {collections.map((item, index) => (
            <button class="collection-tab" type="button" role="tab" aria-selected="false" aria-controls={`panel-${item.id}`} data-show-panel={item.id}>
              <span class={`image-slice slice-${index + 1}`} style={`background-image:url(${plate})`} aria-hidden="true"></span>
              <span class="tab-copy"><span class="tab-label" data-en={item.enLabel} data-zh={item.zhLabel}>{item.enLabel}</span><strong data-en={item.en} data-zh={item.zh}>{item.en}</strong></span>
              <span class="tab-arrow" aria-hidden="true">&#8594;</span>
            </button>
          ))}
        </div>
        <p class="image-note" data-en="Decorative generated archival imagery; not research data." data-zh="装饰性生成档案图像，并非研究数据。">Decorative generated archival imagery; not research data.</p>
      </div>

      <div class="display-area" aria-live="polite">
        <section class="display-panel is-active" id="panel-intro" data-panel="intro">
          <p class="overline" data-en="A SHORT INTRODUCTION" data-zh="个人介绍">A SHORT INTRODUCTION</p>
          <h2><span data-en="Wency Miao" data-zh="缪文希">Wency Miao</span></h2>
          <p class="lead" data-en="I am interested in how evidence travels between life sciences, healthcare, research and education." data-zh="我关注证据如何在生命科学、医疗健康、研究与教育之间流动。">I am interested in how evidence travels between life sciences, healthcare, research and education.</p>
          <p data-en="My background includes Biological Sciences study at Imperial College London, healthcare market and industry research, biotechnology R&D experience, and science teaching and outreach." data-zh="我的背景包括帝国理工学院生物科学学习经历、医疗市场与行业研究、生物科技研发实践，以及科学教学与科普。">My background includes Biological Sciences study at Imperial College London, healthcare market and industry research, biotechnology R&amp;D experience, and science teaching and outreach.</p>
          <div class="timeline-space">
            <div><p class="overline" data-en="TIMELINE" data-zh="时间轴">TIMELINE</p><span data-en="Dates to be confirmed" data-zh="日期待确认">Dates to be confirmed</span></div>
            <div class="timeline-line" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <p data-en="Selected study, research and practice milestones will appear here once their dates and wording are confirmed." data-zh="学习、研究与实践的重要节点将在日期和表述确认后呈现在这里。">Selected study, research and practice milestones will appear here once their dates and wording are confirmed.</p>
          </div>
        </section>

        {collections.map((item) => (
          <section class="display-panel" id={`panel-${item.id}`} data-panel={item.id} hidden>
            <button class="panel-back" type="button" data-show-panel="intro"><span aria-hidden="true">&#8592;</span> <span data-en="Back to introduction" data-zh="返回个人介绍">Back to introduction</span></button>
            <p class="overline" data-en={item.enLabel} data-zh={item.zhLabel}>{item.enLabel}</p>
            <h2 data-en={item.en} data-zh={item.zh}>{item.en}</h2>
            <p class="lead" data-en={item.enBody} data-zh={item.zhBody}>{item.enBody}</p>
            <div class="record-status"><span data-en="Collection status" data-zh="内容状态">Collection status</span><strong data-en="In formation" data-zh="整理中">In formation</strong></div>
          </section>
        ))}
      </div>
    </section>

    <p class="prototype-note" data-en="Interactive example based on Direction D. The current Academic page is unchanged." data-zh="基于方向 D 的交互实例。当前正式 Academic 页面未作修改。">Interactive example based on Direction D. The current Academic page is unchanged.</p>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector('.museum-example');
  const languageButtons = [...document.querySelectorAll('[data-language-choice]')];
  const panelButtons = [...document.querySelectorAll('[data-show-panel]')];
  const panels = [...document.querySelectorAll('[data-panel]')];
  const translatable = [...document.querySelectorAll('[data-en][data-zh]')];

  const setLanguage = (language) => {
    root?.setAttribute('data-language', language);
    document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
    translatable.forEach((element) => { element.textContent = element.dataset[language]; });
    languageButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.languageChoice === language)));
  };

  const showPanel = (panelId) => {
    panels.forEach((panel) => {
      const active = panel.dataset.panel === panelId;
      panel.hidden = !active;
      panel.classList.toggle('is-active', active);
    });
    document.querySelectorAll('.collection-tab').forEach((button) => button.setAttribute('aria-selected', String(button.dataset.showPanel === panelId)));
  };

  languageButtons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.languageChoice)));
  panelButtons.forEach((button) => button.addEventListener('click', () => showPanel(button.dataset.showPanel)));
</script>

<style>
  :global(body){background:#f3f0e8;color:#1d3044}.prototype-nav{width:100%;padding:13px 30px;display:grid;grid-template-columns:1fr auto 1fr;border-bottom:1px solid #cbc5b9;background:#ebe7dc;font-size:10px;color:#59636b}.prototype-nav>a:last-child{text-align:right}.museum-example{width:min(1180px,calc(100% - 64px));margin:auto;padding:24px 0 30px}.museum-header{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding-bottom:14px;border-bottom:1px solid #919b9e}.wordmark{font:18px Georgia,serif}.museum-header>p{font-size:9px;letter-spacing:2px;color:#667077}.language-switch{justify-self:end;display:flex;align-items:center;gap:7px}.language-switch button{border:0;background:transparent;padding:5px 3px;color:#667077;cursor:pointer;font:10px Arial,sans-serif}.language-switch button[aria-pressed=true]{color:#1d3044;border-bottom:1px solid #1d3044}.museum-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(380px,1fr);min-height:690px}.collection-index{padding:48px 38px 50px 0;border-right:1px solid #b8b6ae}.index-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:45px}.overline{font-size:9px;letter-spacing:2px;color:#697177}.index-heading h1{font-size:clamp(42px,5vw,62px);line-height:1.05;letter-spacing:0;margin-top:9px}.about-button,.panel-back{border:0;background:transparent;color:#5e6870;padding:7px 0;border-bottom:1px solid #a9a59c;font-size:10px;cursor:pointer}.collection-tabs{border-top:1px solid #969b9a}.collection-tab{width:100%;display:grid;grid-template-columns:120px 1fr 28px;gap:24px;align-items:center;min-height:150px;padding:14px 8px;border:0;border-bottom:1px solid #bbb7ae;background:transparent;color:inherit;text-align:left;cursor:pointer}.image-slice{height:120px;background-size:370px auto;background-repeat:no-repeat;border:1px solid #aaa398;filter:sepia(.2) saturate(.62);transition:filter .25s,transform .25s}.slice-1{background-position:50% 4%}.slice-2{background-position:50% 49%}.slice-3{background-position:50% 94%}.tab-copy{display:flex;flex-direction:column;gap:11px}.tab-label{font-size:8px;letter-spacing:1.4px;color:#73787a}.tab-copy strong{font:24px/1.2 Georgia,serif}.tab-arrow{font-size:17px;color:#747b7e;transition:transform .2s}.collection-tab:hover .image-slice,.collection-tab[aria-selected=true] .image-slice{filter:sepia(.05) saturate(.85);transform:translateY(-2px)}.collection-tab:hover .tab-arrow{transform:translateX(4px)}.collection-tab[aria-selected=true]{background:rgba(255,255,255,.22)}.image-note{font-size:9px;color:#747a7d;margin-top:16px}.display-area{padding:73px 0 60px 48px;position:relative}.display-panel{max-width:430px;animation:panel-in .28s ease}.display-panel[hidden]{display:none}.display-panel h2{font-size:48px;line-height:1.08;margin:26px 0 30px}.display-panel>p:not(.overline){font:15px/1.85 Georgia,serif;color:#3f4b55;margin-bottom:20px}.display-panel .lead{font-size:19px!important;color:#1d3044!important}.panel-back{margin-bottom:50px}.record-status{margin-top:48px;padding-top:14px;border-top:1px solid #b9b6ad;display:flex;justify-content:space-between;font-size:10px}.record-status span{text-transform:uppercase;letter-spacing:1px;color:#687176}.record-status strong{font-weight:normal}.timeline-space{margin-top:55px;padding-top:20px;border-top:1px solid #b9b6ad}.timeline-space>div:first-child{display:flex;justify-content:space-between;align-items:center}.timeline-space>div span{font-size:9px;color:#747a7d}.timeline-line{display:grid!important;grid-template-columns:repeat(4,1fr);position:relative;margin:28px 0 20px}.timeline-line::before{content:'';position:absolute;left:0;right:0;top:4px;border-top:1px solid #9da19f}.timeline-line i{width:9px;height:9px;border:1px solid #825842;border-radius:50%;background:#f3f0e8;position:relative}.timeline-line i:not(:first-child){justify-self:end}.timeline-space>p{font:13px/1.7 Georgia,serif;color:#5c6469}.prototype-note{border-top:1px solid #b9b6ad;padding-top:23px;text-align:center;font-size:9px;color:#747a7d}@keyframes panel-in{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
  @media(max-width:820px){.museum-example{width:calc(100% - 44px)}.museum-layout{grid-template-columns:1fr}.collection-index{padding:40px 0;border-right:0}.display-area{border-top:1px solid #919b9e;padding:45px 0;min-height:540px}.display-panel{max-width:560px}.prototype-nav{grid-template-columns:1fr 1fr}.prototype-nav>span{display:none}.prototype-nav>a:last-child{text-align:right}.museum-header{grid-template-columns:1fr auto}.museum-header>p{display:none}.collection-tab{grid-template-columns:100px 1fr 24px}.image-slice{height:100px}.index-heading{margin-bottom:30px}}
  @media(max-width:520px){.museum-example{width:calc(100% - 36px)}.prototype-nav{padding:12px 18px}.museum-header{padding-top:3px}.index-heading{align-items:flex-start;flex-direction:column}.index-heading h1{font-size:43px}.collection-tab{grid-template-columns:85px 1fr 18px;gap:15px;min-height:125px;padding:12px 0}.image-slice{height:92px}.tab-copy strong{font-size:21px}.display-panel h2{font-size:40px}.display-area{min-height:590px}.language-switch{gap:4px}}
  @media(prefers-reduced-motion:reduce){.display-panel{animation:none}.image-slice,.tab-arrow{transition:none}}
</style>
