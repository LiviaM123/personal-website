---
import BaseLayout from '../../layouts/BaseLayout.astro';

const { concept } = Astro.props;
const base = import.meta.env.BASE_URL;
const plate = `${base}design-lab/academic-plate.webp`;
const concepts = {
  'archive-index': ['A', 'Archive Index', 'REGISTER / ACADEMIC COLLECTION'],
  'natural-history': ['B', 'Natural History Catalogue', 'PLATES / OBSERVATIONS / NOTES'],
  'reading-room': ['C', 'Manuscript Reading Room', 'A QUIET CATALOGUE OF WORK'],
  'museum-collection': ['D', 'Museum Collection', 'SELECTED FIELDS / OPEN COLLECTION'],
};
const [letter, title, label] = concepts[concept];
const categories = [
  { id:'healthcare', number:'01', title:'Healthcare & Strategy', note:'Market assessment, industry landscapes and competitive research through work with Roland Berger PTA.' },
  { id:'education', number:'02', title:'Education & Outreach', note:'Experimental teaching and science outreach at the DNA Learning Center Asia, alongside biology teaching in Sichuan.' },
  { id:'life-sciences', number:'03', title:'Life Sciences & Research', note:'Biological sciences study, biotechnology R&D exposure, and analysis of cattle social networks and growth performance.' },
];
const descriptions = {
  'archive-index':'A numbered index for moving through an interdisciplinary body of work.',
  'natural-history':'Three fields gathered as specimens of practice: observed carefully, arranged without forcing them into one label.',
  'reading-room':'An invitation to read across research, industry and teaching as connected lines of inquiry.',
  'museum-collection':'A compact collection of the settings in which questions became practical work.',
};
---
<BaseLayout signatureOnly title={`${title} — Academic Study`} description={`A temporary Academic landing page study for Wency Miao: ${title}.`}>
  <nav class="study-nav" aria-label="Academic study navigation">
    <a href={`${base}design-lab/academic/`}>Academic studies</a>
    <div>
      {Object.entries(concepts).map(([slug, data]) => <a href={`${base}design-lab/academic/${slug}/`} aria-current={slug === concept ? 'page' : undefined}>{data[0]}</a>)}
    </div>
    <a href={`${base}academic/`}>Current Academic page</a>
  </nav>

  <main id="main" class={`academic-study study-${concept}`}>
    <header class="study-header">
      <p class="catalogue-mark">WENCY MIAO / ACADEMIC</p>
      <p>{label}</p>
    </header>

    <section class="landing" aria-labelledby="study-title">
      <div class="collection-side">
        <div class="title-block">
          <span class="concept-letter">{letter}</span>
          <div><p class="kicker">TEMPORARY STUDY</p><h1 id="study-title">{title}</h1></div>
        </div>
        {concept === 'natural-history' && <figure class="plate"><img src={plate} alt="Decorative generated archival plate showing botanical, laboratory and cattle-network motifs" /><figcaption>Decorative study plate / generated image / not research data</figcaption></figure>}
        <div class="collection-list" aria-label="Academic collection categories">
          {categories.map((item, index) => (
            <a class="collection-item" href={`#${item.id}`}>
              {concept === 'museum-collection' && <span class={`image-slice slice-${index + 1}`} style={`background-image:url(${plate})`} aria-hidden="true"></span>}
              <span class="record-number">{concept === 'natural-history' ? `PL. ${['XII','XIII','XIV'][index]}` : item.number}</span>
              <span class="record-title">{item.title}</span>
              <span class="record-action">View note <b aria-hidden="true">&#8594;</b></span>
            </a>
          ))}
        </div>
      </div>

      <aside class="introduction">
        <p class="intro-label">A SHORT INTRODUCTION</p>
        <h2>Wency Miao<br /><span>缪文希</span></h2>
        <p class="intro-lead">I am interested in how evidence travels between life sciences, healthcare, research and education.</p>
        <p>My background includes Biological Sciences study at Imperial College London, healthcare market and industry research with Roland Berger PTA, biotechnology R&amp;D experience, and science teaching and outreach.</p>
        <p>{descriptions[concept]}</p>
        {concept === 'reading-room' && <p class="hand-note">“A place for questions, methods,<br />and the work in between.”</p>}
        <dl><div><dt>Collection</dt><dd>Three fields</dd></div><div><dt>Status</dt><dd>In formation</dd></div></dl>
      </aside>
    </section>

    <section class="collection-notes" aria-label="Collection notes">
      <p class="notes-heading">COLLECTION NOTES / SELECTED CONTEXT</p>
      {categories.map((item) => (
        <article id={item.id}>
          <span>{item.number}</span><div><h2>{item.title}</h2><p>{item.note}</p></div><a href="#study-title">Back to index</a>
        </article>
      ))}
    </section>

    <p class="prototype-note">Study {letter} / {title}. Temporary comparison only; the current Academic page is unchanged.</p>
  </main>
</BaseLayout>

<style>
  :global(body){background:#f3f0e8;color:#1d3044}.study-nav{width:100%;padding:14px 30px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid #c9c4b8;background:#ebe7dc;font-size:10px;letter-spacing:.5px}.study-nav>div{display:flex;gap:9px}.study-nav>div a{width:28px;height:28px;border:1px solid transparent;display:grid;place-items:center}.study-nav a[aria-current=page]{border-color:#1d3044}.study-nav>a:last-child{text-align:right}.academic-study{width:min(1180px,calc(100% - 64px));margin:auto;padding:25px 0 32px}.study-header{display:flex;justify-content:space-between;border-bottom:1px solid #9ca3a5;padding-bottom:12px;font-size:9px;letter-spacing:1.8px;color:#5d6469}.landing{display:grid;grid-template-columns:minmax(0,1.22fr) minmax(360px,1fr);min-height:680px}.collection-side{padding:44px 38px 48px 0;border-right:1px solid #b9b7b0}.title-block{display:flex;gap:25px;align-items:flex-start;margin-bottom:43px}.concept-letter{font:italic 50px/1 Georgia,serif;color:#8a6049}.kicker,.intro-label,.notes-heading{font-size:9px;letter-spacing:2px;color:#687076}.title-block h1{font-size:clamp(42px,5.5vw,68px);line-height:1.03;letter-spacing:0;margin-top:8px}.collection-list{border-top:1px solid #8f989d}.collection-item{display:grid;grid-template-columns:62px 1fr auto;gap:18px;align-items:center;min-height:115px;border-bottom:1px solid #b9b7b0;padding:19px 10px}.record-number{font:italic 15px Georgia,serif;color:#8a6049}.record-title{font:27px/1.15 Georgia,serif}.record-action{font-size:9px;letter-spacing:1.2px;color:#5d6469}.record-action b{font-size:16px;margin-left:8px;font-weight:normal}.collection-item:hover .record-title{text-decoration:underline;text-underline-offset:7px}.introduction{padding:69px 0 70px 42px;align-self:start;position:sticky;top:0;min-height:620px}.introduction h2{font-size:42px;line-height:1.08;margin:25px 0 30px}.introduction h2 span{font-size:22px;color:#87634e}.introduction>p:not(.intro-label):not(.hand-note){font:15px/1.85 Georgia,serif;margin-bottom:21px;color:#3f4b55}.introduction .intro-lead{font-size:19px!important;color:#1d3044!important;max-width:420px}.introduction dl{border-top:1px solid #b9b7b0;margin-top:34px;padding-top:13px;font-size:10px}.introduction dl div{display:flex;justify-content:space-between;padding:7px 0}.introduction dt{letter-spacing:1px;text-transform:uppercase;color:#687076}.introduction dd{margin:0}.collection-notes{border-top:1px solid #9ca3a5;padding:35px 0 15px}.notes-heading{margin-bottom:7px}.collection-notes article{display:grid;grid-template-columns:60px 1fr 90px;gap:20px;padding:28px 0;border-bottom:1px solid #cbc7be;scroll-margin-top:20px}.collection-notes article>span{font:italic 16px Georgia,serif;color:#8a6049}.collection-notes h2{font-size:23px;margin-bottom:7px}.collection-notes article p{font-size:13px;line-height:1.7;color:#5d6469;max-width:720px}.collection-notes article a{font-size:9px;letter-spacing:1px;text-transform:uppercase}.prototype-note{text-align:center;font-size:10px;color:#687076;padding-top:27px}
  .study-archive-index .collection-item{border:1px solid #9ea3a2;border-top:0;padding-left:17px}.study-archive-index .collection-list{border-top:1px solid #9ea3a2}.study-archive-index .record-number{border-right:1px solid #b9b7b0;align-self:stretch;display:flex;align-items:center}.study-archive-index .collection-side{background:linear-gradient(90deg,transparent 0 96%,rgba(29,48,68,.025) 96%)}
  .study-natural-history .title-block{margin-bottom:27px}.plate{margin:0 0 31px;border:1px solid #aba598;padding:9px;background:#e8e1d2}.plate img{display:block;width:100%;height:245px;object-fit:cover;object-position:center 12%;filter:sepia(.15) saturate(.7) contrast(.96)}.plate figcaption{font-size:8px;letter-spacing:1.1px;color:#6d675f;padding:7px 2px 0;text-transform:uppercase}.study-natural-history .collection-item{min-height:78px}.study-natural-history .record-title{font-size:24px}.study-natural-history .introduction{padding-top:250px}.study-natural-history{font-family:Georgia,'Times New Roman',serif}.study-natural-history .study-nav,.study-natural-history .record-action{font-family:Arial,sans-serif}
  .study-reading-room{background-image:repeating-linear-gradient(0deg,rgba(57,47,35,.018) 0,rgba(57,47,35,.018) 1px,transparent 1px,transparent 5px)}.study-reading-room .collection-side{padding-top:75px}.study-reading-room .title-block{margin-bottom:74px}.study-reading-room .concept-letter{font-size:31px}.study-reading-room .collection-list{border-top:0}.study-reading-room .collection-item{grid-template-columns:45px 1fr auto;min-height:92px;padding-left:0}.study-reading-room .record-title{font-size:24px}.study-reading-room .introduction{padding-top:110px}.study-reading-room .introduction h2{font-size:48px}.hand-note{font:italic 18px/1.7 Georgia,serif!important;color:#8a6049!important;transform:rotate(-1.5deg);margin:38px 0!important;padding-left:15px;border-left:1px solid #a78975}
  .study-museum-collection .collection-item{grid-template-columns:120px 50px 1fr auto;min-height:145px;padding:12px 9px}.image-slice{height:116px;background-size:360px auto;background-repeat:no-repeat;filter:sepia(.2) saturate(.62);border:1px solid #aaa398;transition:filter .25s,transform .25s}.slice-1{background-position:50% 4%}.slice-2{background-position:50% 49%}.slice-3{background-position:50% 94%}.study-museum-collection .collection-item:hover .image-slice{filter:sepia(.05) saturate(.82);transform:translateY(-2px)}.study-museum-collection .record-title{font-size:24px}
  @media(max-width:820px){.academic-study{width:calc(100% - 44px)}.landing{grid-template-columns:1fr}.collection-side{padding:38px 0 42px;border-right:0}.introduction{position:static;border-top:1px solid #9ca3a5;padding:45px 0}.study-natural-history .introduction,.study-reading-room .introduction{padding-top:45px}.study-nav{padding:12px 20px;grid-template-columns:1fr auto}.study-nav>a:last-child{display:none}.record-title{font-size:23px}.study-museum-collection .collection-item{grid-template-columns:92px 42px 1fr}.study-museum-collection .record-action{display:none}.image-slice{height:95px}.collection-notes article{grid-template-columns:42px 1fr}.collection-notes article a{grid-column:2}.plate img{height:230px}}
  @media(max-width:520px){.academic-study{width:calc(100% - 36px)}.study-header p:last-child{display:none}.title-block{gap:14px;margin-bottom:30px}.concept-letter{font-size:37px}.title-block h1{font-size:42px}.collection-item{grid-template-columns:42px 1fr;gap:11px;min-height:104px;padding-left:2px}.record-action{grid-column:2}.study-archive-index .record-number{border-right:0}.study-reading-room .title-block{margin-bottom:45px}.study-museum-collection .collection-item{grid-template-columns:86px 1fr;gap:13px}.study-museum-collection .record-number{display:none}.study-museum-collection .record-title{font-size:22px}.image-slice{grid-row:1 / span 2;height:92px}.introduction h2{font-size:39px}.introduction .intro-lead{font-size:18px!important}.collection-notes article{padding:23px 0}.study-nav>div{gap:3px}}
  @media(prefers-reduced-motion:reduce){.image-slice{transition:none}}
</style>
